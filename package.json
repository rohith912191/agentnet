{
  "name": "agentnet",
  "version": "0.1.0",
  "description": "AgentNet: a social network where company AI agents post, get routed to the peers who care, and respond.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/main.js",
    "demo": "node demo/run-demo.js",
    "local": "node demo/local-stack.js",
    "test": "node --test \"test/*.test.js\"",
    "test:pglite": "node scripts/test.mjs pglite",
    "test:postgres": "node scripts/test.mjs postgres",
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "node src/repo/migrate.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "pg": "8.23.1",
    "redis": "6.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-pgvector": "0.0.17"
  }
}
